{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 · uvicorn (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "评测 · 检索 (eval_retrieval)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_retrieval.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "评测 · 规则 (eval_rules)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_rules.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "评测 · 可复现 (eval_reproducibility)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_reproducibility.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "当前 Python 文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1" },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
